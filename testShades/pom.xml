<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.sparkutils</groupId>
    <artifactId>kogito-4-spark${shadeSuffix}_testshade_${dbrCompatVersion}${sparkCompatVersion}_${scalaCompatVersion}
    </artifactId>
    <version>${revision}</version>
    <packaging>jar</packaging>

    <name>kogito-4-spark Test Pack</name>
    <description>Packaged tests and shaded jar for deploying in Databricks, or similar to verify builds still run
    </description>
    <url>https://sparkutils.github.io/kogito-4-spark/</url>

    <licenses>
        <license>
            <name>The Apache Software License, Version 2.0</name>
            <url>https://github.com/sparkutils/kogito-4-spark/blob/main/LICENSE</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Chris Twiner</name>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/sparkutils/kogito-4-spark.git</connection>
        <developerConnection>scm:git:ssh://github.com:sparkutils/kogito-4-spark.git</developerConnection>
        <url>http://github.com/sparkutils/kogito-4-spark/tree/master</url>
    </scm>

    <profiles>
        <profile>
            <id>client</id>
            <properties>
                <shadeSuffix>_connect</shadeSuffix>
            </properties>
            <!-- pure api needed with tests, but no server components -->
            <dependencies>
                <dependency>
                    <groupId>com.sparkutils</groupId>
                    <artifactId>dmn-4-spark_api_${dbrCompatVersion}${sparkCompatVersion}_${scalaCompatVersion}</artifactId>
                    <version>${dmn4SparkVersion}</version>
                </dependency>
                <dependency>
                    <groupId>com.sparkutils</groupId>
                    <artifactId>kogito-4-spark_${dbrCompatVersion}${sparkCompatVersion}_${scalaCompatVersion}</artifactId>
                    <version>${revision}</version>
                    <classifier>tests</classifier>
                    <type>test-jar</type>
                    <exclusions>
                        <exclusion>
                            <groupId>com.sparkutils</groupId>
                            <artifactId>kogito-4-spark_${dbrCompatVersion}${sparkCompatVersion}_${scalaCompatVersion}</artifactId>
                        </exclusion>
                        <exclusion>
                            <groupId>com.sparkutils</groupId>
                            <artifactId>dmn-4-spark_${dbrCompatVersion}${sparkCompatVersion}_${scalaCompatVersion}</artifactId>
                        </exclusion>
                        <exclusion>
                            <groupId>com.sparkutils</groupId>
                            <artifactId>kogito_shaded</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>server</id>
            <properties>
                <shadeSuffix/>
            </properties>
            <!-- server components only, kogito-4-spark already filters out the api_stub -->
            <dependencies>
                <dependency>
                    <groupId>com.sparkutils</groupId>
                    <artifactId>kogito-4-spark_${dbrCompatVersion}${sparkCompatVersion}_${scalaCompatVersion}</artifactId>
                    <version>${revision}</version>
                </dependency>
                <dependency>
                    <groupId>com.sparkutils</groupId>
                    <artifactId>kogito-4-spark_${dbrCompatVersion}${sparkCompatVersion}_${scalaCompatVersion}</artifactId>
                    <version>${revision}</version>
                    <classifier>tests</classifier>
                    <type>test-jar</type>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>scala_2.12.18</id> <!-- 4 was built against this, seemingly dropped since Sep 23 -->
            <properties>
                <scalaVersion>2.12.18</scalaVersion>
                <scalaCompatVersion>2.12</scalaCompatVersion>
            </properties>
        </profile>
        <profile>
            <id>scala_2.13.18</id><!-- spark4.1  -->
            <properties>
                <scalaVersion>2.13.18</scalaVersion>
                <scalaCompatVersion>2.13</scalaCompatVersion>
                <scalatestVersion>3.0.9</scalatestVersion>
            </properties>
        </profile>
        <profile>
            <id>14.3.dbr</id>
            <properties>
                <profileDir>14.3.dbr</profileDir>
                <encodingDir>classicEncoding</encodingDir>

                <shimRuntime>14.3.dbr</shimRuntime>
                <shimCompilationRuntime>14.3.dbr</shimCompilationRuntime>
                <dbrCompatVersion>14.3.dbr_</dbrCompatVersion>

                <sparkVersion>3.5.0</sparkVersion>
                <sparkCompatVersion>3.5</sparkCompatVersion>

                <elidebelow>2</elidebelow>

                <framelessVersion>0.17.0</framelessVersion>
                <framelessCoreCompatVersion>_3.5</framelessCoreCompatVersion>
                <framelessCompatVersion>_3.5</framelessCompatVersion>
                <framelessOrg>com.sparkutils</framelessOrg>

                <javaLangVersion>17</javaLangVersion>
            </properties>
        </profile>
        <profile>
            <id>17.3.dbr</id>
            <properties>
                <profileDir>17.3.dbr</profileDir>
                <encodingDir>agnosticEncoding</encodingDir>

                <shimRuntime>17.3.dbr</shimRuntime>
                <shimCompilationRuntime>17.3.dbr</shimCompilationRuntime>
                <dbrCompatVersion>17.3.dbr_</dbrCompatVersion>

                <sparkVersion>4.0.0</sparkVersion>
                <sparkCompatVersion>4.0</sparkCompatVersion>

                <elidebelow>2</elidebelow>

                <framelessVersion>2.0.0-agEnc-baseline</framelessVersion>
                <framelessCoreCompatVersion>_4.0</framelessCoreCompatVersion>
                <framelessCompatVersion>_4.0</framelessCompatVersion>
                <framelessOrg>com.sparkutils</framelessOrg>

                <javaLangVersion>17</javaLangVersion>
            </properties>
        </profile>
        <profile>
            <id>18.3.dbr</id>
            <properties>
                <profileDir>18.3.dbr</profileDir>
                <encodingDir>agnosticEncoding</encodingDir>

                <shimRuntime>18.3.dbr</shimRuntime>
                <shimCompilationRuntime>18.3.dbr</shimCompilationRuntime>
                <dbrCompatVersion>18.3.dbr_</dbrCompatVersion>

                <sparkVersion>4.1.0</sparkVersion>
                <sparkCompatVersion>4.1</sparkCompatVersion>

                <elidebelow>2</elidebelow>

                <framelessVersion>2.0.0-agEnc-baseline</framelessVersion>
                <framelessCoreCompatVersion>_4.0</framelessCoreCompatVersion>
                <framelessCompatVersion>_4.0</framelessCompatVersion>
                <framelessOrg>com.sparkutils</framelessOrg>

                <javaLangVersion>17</javaLangVersion>
            </properties>
        </profile>
        <profile>
            <id>Spark350</id>
            <properties>
                <shimRuntime>3.5.0.oss</shimRuntime>
                <shimCompilationRuntime>3.5.0.oss</shimCompilationRuntime>
                <dbrCompatVersion>3.5.0.oss_</dbrCompatVersion>
                <sparkVersion>3.5.0</sparkVersion>
                <sparkCompatVersion>3.5</sparkCompatVersion>
                <profileDir>3.5.0</profileDir>
                <encodingDir>classicEncoding</encodingDir>
                <elidebelow>2</elidebelow>

                <framelessVersion>0.17.0</framelessVersion>
                <framelessCoreCompatVersion>_3.5</framelessCoreCompatVersion>
                <framelessCompatVersion>_3.5</framelessCompatVersion>
                <framelessOrg>com.sparkutils</framelessOrg>

                <javaLangVersion>17</javaLangVersion>
            </properties>
        </profile>
        <profile>
            <id>Spark4</id>
            <properties>
                <shimRuntime>4.0.0.oss</shimRuntime>
                <shimCompilationRuntime>4.0.0.oss</shimCompilationRuntime>
                <dbrCompatVersion>4.0.0.oss_</dbrCompatVersion>
                <sparkVersion>4.0.0</sparkVersion>
                <sparkCompatVersion>4.0</sparkCompatVersion>
                <profileDir>4.0.0</profileDir>
                <encodingDir>agnosticEncoding</encodingDir>
                <elidebelow>2</elidebelow>

                <framelessVersion>2.0.0-agEnc-baseline</framelessVersion>
                <framelessCoreCompatVersion>_4.0</framelessCoreCompatVersion>
                <framelessCompatVersion>_4.0</framelessCompatVersion>
                <framelessOrg>com.sparkutils</framelessOrg>

                <javaLangVersion>17</javaLangVersion>
            </properties>
        </profile>
        <profile>
            <id>Spark41</id>
            <properties>
                <shimRuntime>4.1.0.oss</shimRuntime>
                <shimCompilationRuntime>4.1.0.oss</shimCompilationRuntime>
                <dbrCompatVersion>4.1.0.oss_</dbrCompatVersion>
                <sparkVersion>4.1.0</sparkVersion>
                <sparkCompatVersion>4.1</sparkCompatVersion>
                <profileDir>4.1.0</profileDir>
                <encodingDir>agnosticEncoding</encodingDir>
                <elidebelow>2</elidebelow>

                <framelessVersion>2.0.0-agEnc-baseline</framelessVersion>
                <framelessCoreCompatVersion>_4.0</framelessCoreCompatVersion>
                <framelessCompatVersion>_4.0</framelessCompatVersion>
                <framelessOrg>com.sparkutils</framelessOrg>

                <javaLangVersion>17</javaLangVersion>
            </properties>
        </profile>
        <profile>
            <id>Spark42</id>
            <properties>
                <shimRuntime>4.2.0.oss</shimRuntime>
                <shimCompilationRuntime>4.2.0.oss</shimCompilationRuntime>
                <dbrCompatVersion>4.2.0.oss_</dbrCompatVersion>
                <sparkVersion>4.2.0</sparkVersion>
                <sparkCompatVersion>4.2</sparkCompatVersion>
                <profileDir>4.2.0</profileDir>
                <encodingDir>agnosticEncoding</encodingDir>
                <elidebelow>2</elidebelow>

                <framelessVersion>2.0.0-agEnc-baseline</framelessVersion>
                <framelessCoreCompatVersion>_4.0</framelessCoreCompatVersion>
                <framelessCompatVersion>_4.0</framelessCompatVersion>
                <framelessOrg>com.sparkutils</framelessOrg>

                <javaLangVersion>17</javaLangVersion>
            </properties>
        </profile>
    </profiles>

    <properties>
        <revision>0.1.0</revision>

        <mavenJarPluginVersion>3.2.0</mavenJarPluginVersion>
        <mavenShadePluginVersion>3.2.1</mavenShadePluginVersion>
        <mavenProjectInfoReportsVersion>3.9.0</mavenProjectInfoReportsVersion>
        <scalaMeterVersion>0.19</scalaMeterVersion>

        <jarjarVersion>1.14.1</jarjarVersion>
        <jarjarCompatVersion>2.12</jarjarCompatVersion>
        <scriptingPluginVersion>3.0.0</scriptingPluginVersion>

        <mavenFlattenPluginVersion>1.2.7</mavenFlattenPluginVersion>
        <mavenProjectInfoReportsPluginVersion>3.4.5</mavenProjectInfoReportsPluginVersion>
        <scalatestVersion>3.0.7</scalatestVersion>
        <junitVersion>4.12</junitVersion>
        <mavenCompilerPluginVersion>3.8.1</mavenCompilerPluginVersion>
        <mavenSitePluginVersion>3.21.0</mavenSitePluginVersion>
        <surefirePluginVersion>2.22.2</surefirePluginVersion>
        <surefireReportPluginVersion>2.22.2</surefireReportPluginVersion>
        <scalatestMavenPluginVersion>2.2.0</scalatestMavenPluginVersion>
        <scoverage.plugin.version>2.5.2</scoverage.plugin.version>
        <naked-local-fs-version>0.1.0</naked-local-fs-version>

        <shimCompilationVersion>0.3.0</shimCompilationVersion>
        <shimRuntimeVersion>0.3.0</shimRuntimeVersion>

        <dmn4SparkVersion>0.1.0</dmn4SparkVersion>
        <shadedKogitoVersion>0.1.0-RC2</shadedKogitoVersion>
        <testingVersion>0.0.1</testingVersion>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-site-plugin</artifactId>
                <version>${mavenSitePluginVersion}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>2.9.1</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <failOnError>false</failOnError>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${mavenCompilerPluginVersion}</version>
                <configuration>
                    <source>${javaLangVersion}</source>
                    <target>${javaLangVersion}</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-project-info-reports-plugin</artifactId>
                <version>${mavenProjectInfoReportsPluginVersion}</version>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${mavenFlattenPluginVersion}</version>
                <configuration>
                    <flattenMode>oss</flattenMode>
                    <updatePomFile>true</updatePomFile>
                </configuration>
                <executions>
                    <!-- enable flattening -->
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <!-- ensure proper cleanup -->
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <id>add-source</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>src/main/scala</source>
                                <source>src/main/${profileDir}-scala</source>
                                <source>src/main/${encodingDir}</source>
                                <source>
                                    ${project.build.directory}/shim_compilation_${shimCompilationRuntime}_${sparkCompatVersion}_${scalaCompatVersion}
                                </source>
                            </sources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>for-scaladocs-etc</id>
                        <phase>pre-site</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>src/main/scala</source>
                                <source>src/main/${profileDir}-scala</source>
                                <source>src/main/${encodingDir}</source>
                            </sources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>add-test-source</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>src/test/scala</source>
                                <source>src/test/${profileDir}-scala</source>
                                <source>src/test/${encodingDir}</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <version>3.0.1</version>
                <executions>
                    <execution>
                        <id>sign-artifacts</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>sign</goal>
                        </goals>
                        <configuration>
                            <!-- Prevent gpg from using pinentry programs -->
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>2.2.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>0.9.0</version>
                <extensions>true</extensions>
                <configuration>
                    <publishingServerId>central</publishingServerId>
                    <autoPublish>true</autoPublish>
                    <waitUntil>published</waitUntil>
                    <ignorePublishedComponents>true</ignorePublishedComponents>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${mavenJarPluginVersion}</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Build-Time>${maven.build.timestamp}</Build-Time>
                        </manifestEntries>
                        <manifestSections>
                            <manifestSection>
                                <name>Versions</name>
                                <manifestEntries>
                                    <Project-Version>${project.version}</Project-Version>
                                    <Project-Git-Hash>${GITHUB_SHA}</Project-Git-Hash>
                                    <Project-CI-Branch>${GITHUB_BASE_REF}</Project-CI-Branch>
                                    <Project-CI-Run-ID>${GITHUB_RUN_ID}</Project-CI-Run-ID>
                                    <Project-URL>${GITHUB_REPOSITORY}</Project-URL>
                                </manifestEntries>
                            </manifestSection>
                        </manifestSections>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${mavenShadePluginVersion}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!-- does not work <minimizeJar>true</minimizeJar> -->
                            <artifactSet>
                                <includes>
                                    <include>com.sparkutils:*</include>
                                    <include>com.sparkutils.:*</include>
                                    <!-- -->
                                    <include>junit:*</include>
                                    <include>org.scalatest:*</include>
                                    <include>com.storm-enroute:*</include>
                                    <include>org.hamcrest:*</include>
                                    <include>com.chuusai:*</include>
                                    <include>org.typelevel:*</include>
                                    <include>org.apache.commons:*</include>
                                    <include>net.openhft:*</include>
                                    <include>org.scalactic:*</include>
                                    <include>org.scalatestplus:*</include>
                                    <include>org.scalacheck:*</include>
                                    <include>com.globalmentor:*</include>
                                </includes>
                                <excludes>
                                    <exclude>com.databricks:*</exclude>
                                    <exclude>io.delta:*</exclude>
                                    <exclude>com.fasterxml.jackson.module:*</exclude>
                                    <exclude>com.fasterxml.jackson.core:*</exclude>
                                    <exclude>org.apache.spark:*</exclude>
                                    <exclude>org.scala-lang:*</exclude>
                                    <exclude>log4j:log4j:jar:</exclude>
                                </excludes>
                            </artifactSet>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-scripting-plugin</artifactId>
                <version>${scriptingPluginVersion}</version>
                <executions>
                    <execution>
                        <id>jarjarCaller</id>
                        <phase>package</phase>
                        <goals>
                            <goal>eval</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <engineName>groovy</engineName>
                    <script>
                        def ogFile = project.getArtifact().getFile()
                        def targetDir = ogFile.getParentFile()
                        def shaded = new java.io.File(targetDir, "shaded-" + ogFile.getName())
                        def rules = (new java.io.File("./shade.rules")).getAbsoluteFile()


                        org.codehaus.plexus.util.FileUtils.rename(ogFile, shaded)
                        new com.eed3si9n.jarjarabrams.Main().process(
                        rules.toPath(),
                        shaded.toPath(),
                        ogFile.toPath()
                        )

                        println "rules: ${rules}"
                        println "ogFile: ${ogFile}"
                        println "targetDir: ${targetDir}"
                        println "shaded: ${shaded}"
                    </script>
                </configuration>
                <dependencies>
                    <!-- ScriptEngines -->
                    <dependency>
                        <groupId>org.apache.groovy</groupId>
                        <artifactId>groovy-jsr223</artifactId>
                        <version>4.0.26</version> <!-- look for latest -->
                    </dependency>
                    <dependency>
                        <groupId>com.eed3si9n.jarjarabrams</groupId>
                        <artifactId>jarjar-abrams-core_${jarjarCompatVersion}</artifactId>
                        <version>${jarjarVersion}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>

    </build>

    <dependencies>
        <dependency>
            <groupId>com.sparkutils</groupId>
            <artifactId>kogito-4-spark_api_${dbrCompatVersion}${sparkCompatVersion}_${scalaCompatVersion}</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>com.sparkutils.</groupId>
            <artifactId>testing_${dbrCompatVersion}${sparkCompatVersion}_${scalaCompatVersion}</artifactId>
            <version>${testingVersion}</version>
        </dependency>
        <!-- need to be included -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junitVersion}</version>
        </dependency>
        <dependency>
            <groupId>${framelessOrg}</groupId>
            <!-- framelessCoreCompatVersion is used as sparkutils.frameless always publishes the spark major.minor -->
            <artifactId>frameless-core${framelessCoreCompatVersion}_${scalaCompatVersion}</artifactId>
            <version>${framelessVersion}</version>
            <exclusions>
                <!-- exclude the shim -->
                <exclusion>
                    <groupId>com.sparkutils</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>${framelessOrg}</groupId>
            <!-- framelessCoreCompatVersion is used as sparkutils.frameless always publishes the spark major.minor -->
            <artifactId>frameless-dataset${framelessCoreCompatVersion}_${scalaCompatVersion}</artifactId>
            <version>${framelessVersion}</version>
            <exclusions>
                <!-- exclude the shim -->
                <exclusion>
                    <groupId>com.sparkutils</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.scalatest</groupId>
            <artifactId>scalatest_${scalaCompatVersion}</artifactId>
            <version>${scalatestVersion}</version>
        </dependency>
        <dependency>
            <groupId>com.storm-enroute</groupId>
            <artifactId>scalameter_${scalaCompatVersion}</artifactId>
            <version>${scalaMeterVersion}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.mongodb</groupId>
                    <artifactId>casbah_${scalaCompatVersion}</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

</project>
